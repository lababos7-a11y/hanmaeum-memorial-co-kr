{
  "name": "han-maum-co-kr",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "postbuild": "node -e \"const{copyFileSync,mkdirSync}=require('fs');mkdirSync('dist/static',{recursive:true});copyFileSync('public/static/common.js','dist/static/common.js');copyFileSync('public/static/style.css','dist/static/style.css');console.log('✓ static/ copied');\"",
    "preview": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "devDependencies": {
    "vite": "^5.4.21",
    "wrangler": "^4.110.0"
  }
}
